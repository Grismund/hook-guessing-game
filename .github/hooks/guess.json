{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "type": "command",
        "bash": "bash .agents/scripts/pre-guess-hook-script.sh",
        "powershell": "pwsh -NoProfile -File .agents/scripts/pre-guess-hook-script.ps1",
        "cwd": ".",
        "timeoutSec": 10
      }
    ],
    "postToolUse": [
      {
        "type": "command",
        "bash": "bash .agents/scripts/post-guess-hook-script.sh",
        "powershell": "pwsh -NoProfile -File .agents/scripts/post-guess-hook-script.ps1",
        "cwd": ".",
        "timeoutSec": 10
      }
    ]
  }
}